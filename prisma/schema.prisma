generator client {
	provider = "prisma-client-js"
}

datasource db {
	provider = "postgresql"
}

model Lead {
	id        String   @id @default(uuid())
	name      String
	email     String?
	phone     String?
	address   String?
	service   String?
	notes     String?
	message   String?
	source    String?
	location  String?
	status    String?
	nextFollowUpAt DateTime?
	// CalmKept Pro licensing fields (2026-07-03)
	tier             String?   // pro | white-label | firm
	firmName         String?
	profession       String?   // advisor | attorney | funeral | hospice | other
	licenseExpiresAt DateTime?
	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt
}
